# Production Environment Configuration
# Live Render PostgreSQL Database

# Database Configuration
# Example: postgresql://user:pass@dpg-xxxxx.postgres-render.com:5432/dbname
DATABASE_URL=postgresql://[YOUR_DB_USER]:[YOUR_DB_PASSWORD]@[YOUR_DB_HOST]:5432/[YOUR_DB_NAME]

# Authentication
JWT_SECRET=prod-jwt-secret-256-bits-long-for-production-use-only-change-this
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_admin_password_123

# AI Configuration
GROQ_API_KEY=[YOUR_GROQ_API_KEY_HERE]
LLM_MODEL=llama-3.1-8b-instant

# Email Configuration
SENDGRID_API_KEY=[YOUR_SENDGRID_API_KEY_HERE]
FROM_EMAIL=himalayanaitech@gmail.com
ADMIN_EMAIL=himalayanaitech@gmail.com

# Application Settings
ENVIRONMENT=production
DEBUG=false
ALLOWED_ORIGINS=https://himalayan-ai-tech-pro.vercel.app,https://himalayan-ai-tech-pro-frontend.vercel.app,http://localhost:3000,http://localhost:3001